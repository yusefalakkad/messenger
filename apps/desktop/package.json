{
  "name": "dakka-desktop",
  "version": "1.0.0",
  "description": "Dakka — десктоп-приложение для macOS (Electron-обёртка)",
  "private": true,
  "main": "main.js",
  "author": "Dakka",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:mac:universal": "electron-builder --mac --universal"
  },
  "devDependencies": {
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "online.akkdmsg.dakka",
    "productName": "Dakka",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/icon.png"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "assets/icon.png",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "darkModeSupport": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Dakka использует микрофон для голосовых сообщений и звонков.",
        "NSCameraUsageDescription": "Dakka использует камеру для видеосообщений и видеозвонков."
      }
    },
    "dmg": {
      "title": "Dakka ${version}",
      "contents": [
        { "x": 130, "y": 220, "type": "file" },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
