<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Базовая тема — далее всё переопределяется в Compose -->
    <style name="Theme.Dakka" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dakka_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Splash-тема (Android 12+ native splash screen) -->
    <style name="Theme.Dakka.Splash" parent="Theme.Dakka">
        <item name="android:windowSplashScreenBackground">@color/dakka_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
    </style>
</resources>
