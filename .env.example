# ─── ОБЯЗАТЕЛЬНО ЗАПОЛНИ ─────────────────────────────────────────────────────

# Домен сервера (используется для CORS, TURN и SSL-сертификата)
# Пример: SERVER_IP=192.168.1.100  или  SERVER_IP=akkdmsg.online
SERVER_IP=akkdmsg.online

# URL фронтенда (совпадает с SERVER_IP но с https://)
CLIENT_URL=https://akkdmsg.online

# JWT секреты — сгенерируй случайные строки (минимум 32 символа каждая)
JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_STRING_ACCESS_32CHARS
JWT_REFRESH_SECRET=CHANGE_ME_LONG_RANDOM_STRING_REFRESH_32CHARS

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=messenger
POSTGRES_PASSWORD=messenger_secret
POSTGRES_DB=messenger_db
# DATABASE_URL автоматически подставляется docker-compose из сервиса postgres
# (не менять)
DATABASE_URL=postgresql://messenger:messenger_secret@postgres:5432/messenger_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
# REDIS_URL автоматически подставляется docker-compose
REDIS_URL=redis://:redis_secret@redis:6379

# ─── MinIO (хранилище файлов) ─────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_secret123
# MINIO_ENDPOINT автоматически = minio (имя сервиса docker)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_MEDIA=messenger-media

# ─── TURN-сервер (для звонков через NAT) ─────────────────────────────────────
# РЕКОМЕНДУЕТСЯ: REST-аутентификация с ephemeral credentials.
# Backend выдаёт клиенту username/credential, сгенерированные HMAC-SHA1 от
# TURN_SECRET с TTL 10 мин. Один секрет знает только сервер + coturn.
TURN_SECRET=CHANGE_ME_LONG_RANDOM_64_HEX_CHARS_MIN

# Realm и домен (общие для обеих схем аутентификации)
TURN_REALM=dakka
# Домен, по которому клиенты будут ходить на TURN. Обычно совпадает с SERVER_IP.
TURN_DOMAIN=

# TLS для turns:// (опционально, рекомендуется в проде)
# Пути внутри контейнера coturn. Получить из Let's Encrypt и пробросить volume.
# TURN_TLS_CERT=/etc/letsencrypt/live/akkdmsg.online/fullchain.pem
# TURN_TLS_KEY=/etc/letsencrypt/live/akkdmsg.online/privkey.pem

# Legacy static credentials (использовать только если TURN_SECRET не задан).
# В новых деплоях НЕ заполнять — backend автоматически перейдёт на REST-схему.
# TURN_USER=
# TURN_PASS=

# ─── LiveKit SFU (групповые звонки до 8 участников) ──────────────────────────
# 1-на-1 звонки используют peer-to-peer WebRTC и НЕ зависят от LiveKit.
# LiveKit нужен только для group-чатов с >2 участниками.
#
# Сгенерировать ключи:
#   docker run --rm livekit/livekit-server generate-keys
# Или вручную: API_KEY = "API" + 12 случайных alphanumeric, API_SECRET = 40+ hex.
# Если оба пусты — backend вернёт 503 LIVEKIT_DISABLED на POST /api/livekit/token,
# и кнопка группового звонка просто не активируется. 1-на-1 звонки продолжают работать.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Публичный WS-эндпоинт. nginx проксирует на livekit-server:7880.
LIVEKIT_URL=wss://akkdmsg.online/livekit

# ─── Cloudflare Tunnel (только для setup-tunnel.sh / docker-compose.tunnel.yml) ─
# Токен туннеля из Cloudflare Zero Trust dashboard.
# Получить: dash.cloudflare.com → Zero Trust → Networks → Tunnels → Create tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Web Push (опционально) ──────────────────────────────────────────────────
# Если не задать — сервер автоматически сгенерирует ключи и положит в Redis.
# Если задать — будут использованы эти. Сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@akkdmsg.online

# ─── iOS Push (APNs) — опционально ───────────────────────────────────────────
# Получить:
#   developer.apple.com → Certificates, IDs & Profiles → Keys → "+"
#   → Apple Push Notification service (APNs) → Download .p8
# Из этого .p8 берём Key ID (имя файла). Team ID — на главной dev account.
APNS_BUNDLE_ID=online.akkdmsg.dakka
APNS_KEY_ID=
APNS_TEAM_ID=
# Содержимое .p8 файла как есть, с переводами строк (в .env заменяем на \n).
APNS_KEY=
# true = боевые серверы APNs, false = sandbox (для dev/TestFlight)
APNS_PRODUCTION=false

# ─── Android Push (FCM) — опционально ────────────────────────────────────────
# Получить:
#   console.firebase.google.com → Project Settings → Service Accounts
#   → Generate new private key → скачается .json файл
# Положить ВСЁ его содержимое в одну строку:
FCM_SERVICE_ACCOUNT=

# ─── Сервер ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ─── SMS / OTP-провайдер ──────────────────────────────────────────────────────
# Каналом доставки OTP-кодов выбирается через SMS_PROVIDER:
#   dev          — НИЧЕГО не отправляется, код печатается в логи + возвращается
#                  клиенту как devOtp. Только для NODE_ENV=development.
#   telegram-bot — БЕСПЛАТНО. Свой Telegram-бот через @BotFather. UX: при первом входе
#                  юзер открывает бота и делится номером — все следующие входы код
#                  приходит мгновенно в тот же чат.
#   telegram     — Telegram Gateway (платный B2B сервис ~$0.01/код). Требует
#                  TELEGRAM_GATEWAY_TOKEN.
SMS_PROVIDER=dev

# ─── Telegram-bot OTP (рекомендуемый бесплатный вариант) ──────────────────────
# Как получить:
#   1) Открой @BotFather в Telegram → /newbot
#   2) Имя бота (видят юзеры): Dakka Auth
#   3) Username бота (обязательно заканчивается на Bot): DakkaAuthBot
#   4) BotFather пришлёт токен 123456:ABC-DEF... — сюда
#   5) Опционально: /setdescription, /setuserpic, /setprivacy=Disable
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=DakkaAuthBot

# Webhook (для prod): URL куда TG будет POST'ить апдейты. Должен быть HTTPS.
# Пример: https://akkdmsg.online/api/telegram/webhook
# Если пусто → backend в dev-режиме использует long-polling.
TELEGRAM_WEBHOOK_URL=
# Секрет для верификации что POST действительно от Telegram (любая длинная строка)
TELEGRAM_WEBHOOK_SECRET=

# ─── Telegram API proxy (для VPS где api.telegram.org заблокирован) ───────────
# Если VPS не дотягивается до api.telegram.org (типично для RU/CIS хостингов),
# поднимаем Cloudflare Worker как HTTP-прокси. См. tools/cloudflare-tg-proxy/README.md
#
# Шаги:
#   1. wrangler deploy (в tools/cloudflare-tg-proxy/) → получишь URL
#   2. wrangler secret put PROXY_AUTH_TOKEN → положить любой длинный токен
#   3. сюда поставь URL и тот же токен:
TELEGRAM_API_BASE=
TELEGRAM_API_PROXY_TOKEN=

# ─── Telegram Gateway (платная альтернатива бесплатному боту) ─────────────────
# Получить:
#   1) gateway.telegram.org → войти через свой Telegram
#   2) Создать аккаунт (Account name=Dakka, Company name=<твоё имя или ИП>)
#   3) Подтвердить email → API → Generate token
TELEGRAM_GATEWAY_TOKEN=

# OTP-параметры (можно оставить значения по умолчанию)
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300              # код живёт 5 мин
OTP_MAX_ATTEMPTS=5               # макс попыток ввода до блокировки
OTP_COOLDOWN_SECONDS=60          # между двумя запросами кода
OTP_MAX_PER_WINDOW=3             # макс запросов кода на номер за окно
OTP_WINDOW_SECONDS=900           # размер окна (15 мин)
